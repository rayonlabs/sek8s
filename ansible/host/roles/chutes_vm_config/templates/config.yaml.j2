# Generated by ansible/host (chutes_vm_config role) — do not edit on host; re-run playbook.
vm:
  hostname: {{ chutes_effective_vm_hostname | to_json }}
  base_image: {{ chutes_vm_base_image | to_json }}
  vm_image_directory: {{ chutes_vm_image_directory | to_json }}

miner:
  ss58: {{ chutes_miner_ss58 | to_json }}
  seed: {{ chutes_miner_seed | to_json }}

{% if chutes_docker_hub_username is defined and chutes_docker_hub_username | length > 0 and chutes_docker_hub_token is defined and chutes_docker_hub_token | length > 0 %}
docker_hub:
  username: {{ chutes_docker_hub_username | to_json }}
  token: {{ chutes_docker_hub_token | to_json }}

{% endif %}
network:
  vm_ip: {{ chutes_guest_vm_ip | to_json }}
  bridge_ip: {{ chutes_guest_bridge_ip | to_json }}
  dns: {{ chutes_network_dns | to_json }}
  public_interface: {{ chutes_guest_public_interface | to_json }}
  type: "tap"
  ssh_port: 2222

volumes:
  cache:
    size: {{ chutes_volume_cache_size | to_json }}
    path: {{ chutes_volume_cache_path | to_json }}
  storage:
    size: {{ chutes_volume_storage_size | to_json }}
    path: {{ chutes_volume_storage_path | to_json }}
  config:
    path: {{ chutes_volume_config_path | to_json }}

devices:
  bind_devices: {{ 'true' if chutes_devices_bind | bool else 'false' }}

runtime:
  foreground: {{ 'true' if chutes_runtime_foreground | bool else 'false' }}
