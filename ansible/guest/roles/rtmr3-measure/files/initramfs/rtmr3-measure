#!/bin/sh
# /etc/initramfs-tools/scripts/init-bottom/rtmr3-measure
#
# Extends TDX RTMR3 with SHA-384 hashes of configured paths on the real
# root filesystem before pivot_root.
#
# Reads /etc/tdx-measure.conf (baked into the initramfs, covered by RTMR1)
# for the list of paths to measure.  For each path, all regular files are
# collected and sorted lexicographically to guarantee a deterministic extend
# chain.  Any offline modification to a measured file will produce a
# different RTMR3 value that verifiers can detect.
#
# For canonical files (e.g. verify-access-config) the build-time SHA-384
# hash is embedded in /etc/tdx-rtmr3-expected-hashes (also covered by RTMR1).
# Each such file is verified against its expected hash before RTMR3 is
# extended.  A mismatch is fatal: the VM powers off.  This means an attacker
# cannot swap the runtime verification tool without either changing RTMR1
# (detectable) or preventing the VM from booting.
#
# Design notes:
#   - init-bottom scripts run after ${rootmnt} is mounted and populated.
#   - Files are read from ${rootmnt}<path>, not from the initramfs itself.
#   - Any failure is fatal: the VM powers off rather than boot with an
#     incomplete or unverifiable RTMR3 measurement chain.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac

. /scripts/functions

# ── Fatal failure handler ────────────────────────────────────────────────────

handle_failure() {
    local reason="$1"
    log_failure_msg "RTMR3 measurement failed: ${reason}"
    echo "RTMR3-MEASURE-FAILED: ${reason}" > /dev/kmsg
    log_failure_msg "VM will shut down in 10 seconds..."
    sleep 10
    poweroff -f
}

log_begin_msg "RTMR3: measuring configured paths"

# ── Ensure TDX device is available ──────────────────────────────────────────

if [ ! -c /dev/tdx_guest ]; then
    modprobe tdx_guest 2>/dev/null || true
    sleep 1
fi

if [ ! -c /dev/tdx_guest ]; then
    handle_failure "TDX device (/dev/tdx_guest) not available — not running in a TDX guest"
fi

# ── Read measurement config ──────────────────────────────────────────────────

if [ ! -f /etc/tdx-measure.conf ]; then
    handle_failure "tdx-measure.conf not found in initramfs"
fi

EXPECTED_HASHES_FILE=/etc/tdx-rtmr3-expected-hashes

# ── Collect and hash every file to measure ──────────────────────────────────
# Paths in the config are relative to the real root (e.g. /etc/ssh), so they are
# read from ${rootmnt}/etc/ssh and emitted root-relative.
#
# WHICH files, in WHAT ORDER and HOW they are hashed all live in tdx-measure — the
# same script the build-time manifest generator, rtmr3-verify and the host-side
# measurement predictor run. This script owns only what is boot-specific: checking
# each hash against the canonical manifest and extending the hardware register.
# Do not re-derive the file list or the hashes here; that is how four walkers came
# to disagree four ways. tdx-measure sorts under LC_ALL=C, refuses a symlinked conf
# entry, and exits non-zero if nothing is measurable; its progress goes to stderr,
# routed here to /dev/kmsg for the miner-visible measurement phase.

measure_start=$(date +%s)
hash_list=$(mktemp)

if ! tdx-measure hash "${rootmnt}" /etc/tdx-measure.conf \
        > "$hash_list" 2> /dev/kmsg; then
    rm -f "$hash_list"
    handle_failure "measured-file enumeration failed — check tdx-measure.conf paths"
fi

collect_elapsed=$(($(date +%s) - measure_start))
echo "RTMR3: file collection complete in ${collect_elapsed}s" > /dev/kmsg

# ── Hash each file and extend RTMR3 ─────────────────────────────────────────

total_files=$(wc -l < "$hash_list")

# Verify every measured file against the build-time manifest in ONE awk pass: the manifest is
# read into memory, then the hash list is streamed past it. The previous form spawned an awk per
# file that rescanned the whole manifest, which is O(n^2) -- at 41k files the per-file cost grew
# from 5ms to 20ms and the phase projected to ~67 minutes.
#
# Both formats carry the 96-char hash at a fixed end of the line, so paths containing spaces are
# handled by offset rather than by field splitting: manifest is "<path> <hash>", the hash list is
# "<hash> <path>".
echo "RTMR3: verifying ${total_files} files against the canonical manifest..." > /dev/kmsg

if [ -f "$EXPECTED_HASHES_FILE" ]; then
    tampered=$(awk '
        NR==FNR {
            if (substr($0,1,1) == "#" || length($0) < 98) next
            expect[substr($0, 1, length($0)-97)] = substr($0, length($0)-95)
            next
        }
        { if ((substr($0,98) in expect) && expect[substr($0,98)] != substr($0,1,96)) {
              print substr($0,98); exit 1 } }
    ' "$EXPECTED_HASHES_FILE" "$hash_list")
    if [ $? -ne 0 ]; then
        rm -f "$hash_list"
        handle_failure "canonical file tampered: ${tampered}"
    fi
fi

# One extend over a digest of the whole chain, not one extend per file. 41k TDCALLs cost ~167s
# of boot and bind nothing a single extend over the ordered list does not: RTMR3 becomes
# SHA384(0^48 || SHA384(hash-list)). Hashing the list text binds the paths too, which the
# per-file content chain did not. chutes_cvm.measurement.rtmr3.fold_chain computes the same.
chain_digest=$(sha384sum < "$hash_list" | cut -d' ' -f1)
rm -f "$hash_list"

if [ -z "$chain_digest" ]; then
    handle_failure "could not compute the chain digest"
fi

if ! tdx-rtmr-extend --index 3 --data "$chain_digest" 2>/dev/null; then
    handle_failure "failed to extend RTMR3"
fi

total_elapsed=$(($(date +%s) - measure_start))
echo "RTMR3: completed — ${total_files} files measured in ${total_elapsed}s" > /dev/kmsg
log_success_msg "RTMR3: extended with ${total_files} file measurement(s) in ${total_elapsed}s"

exit 0
