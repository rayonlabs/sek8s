#!/bin/sh
# /etc/initramfs-tools/hooks/rtmr3-measure
#
# Initramfs-tools hook for the RTMR3 measurement feature.
# Copies tdx-rtmr-extend (sysfs-based, no external libs), sha384sum,
# the tdx_guest kernel module, /etc/tdx-measure.conf, and
# /etc/tdx-rtmr3-expected-hashes into the initramfs image so the
# init-bottom script can verify canonical files and extend RTMR3 at boot.
#
# Both config files are baked into the initramfs and covered by RTMR1.
# Tampering with either requires changing the initramfs, which changes RTMR1.

PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac

. /usr/share/initramfs-tools/hook-functions

# Binary that extends a TDX RTMR via the tsm-mr sysfs interface (kernel 6.16+)
copy_exec /usr/local/bin/tdx-rtmr-extend

# sha384sum for hashing measured files (from coreutils — always present)
copy_exec /usr/bin/sha384sum

# The single implementation of which files are measured, in what order, and how each
# is hashed — shared with the build-time manifest generator, rtmr3-verify and the
# host-side measurement predictor, so none of them can enumerate or hash differently.
# POSIX sh over find/sed/sort/wc/mktemp/sha384sum, all present in the initramfs.
copy_exec /usr/local/bin/tdx-measure

# TDX guest kernel module — needed so /dev/tdx_guest is available
manual_add_modules tdx_guest
force_load tdx_guest

# Measurement config: the static list of paths to measure into RTMR3.
# The file is hardcoded in the role source (files/tdx-measure-miner.conf or
# files/tdx-measure-gpu.conf, selected by rtmr3_vm_type in the calling playbook)
# and is not driven by Ansible variables, ensuring the measured path list is
# fixed and reproducible from the repository.  Baking it into the initramfs
# (covered by RTMR1) additionally ensures the list cannot be tampered with
# at runtime without changing RTMR1.
if [ -f /etc/tdx-measure.conf ]; then
    mkdir -p "$DESTDIR/etc"
    cp /etc/tdx-measure.conf "$DESTDIR/etc/tdx-measure.conf"
fi

# Expected hashes for canonical files: build-time SHA-384 constants that the
# init-bottom script verifies before extending RTMR3.  A mismatch powers off
# the VM.  Baking this file into the initramfs (covered by RTMR1) means any
# attacker who changes a canonical file (e.g. verify-access-config) must also
# update this constant, which changes RTMR1 — detectable by the partner.
if [ -f /etc/tdx-rtmr3-expected-hashes ]; then
    mkdir -p "$DESTDIR/etc"
    cp /etc/tdx-rtmr3-expected-hashes "$DESTDIR/etc/tdx-rtmr3-expected-hashes"
fi
