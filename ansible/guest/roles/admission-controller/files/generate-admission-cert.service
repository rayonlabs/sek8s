[Unit]
Description=Generate per-VM admission controller TLS material and inject webhook caBundle
Documentation=file:/usr/local/bin/generate-admission-cert
# Certs and webhook manifests live on the storage bind-mount; must run after
# mounts are active and after rtmr3-verify confirms RTMR3 integrity against the
# placeholder manifests.
After=setup-storage-bind-mounts.service
After=rtmr3-verify.service
Requires=setup-storage-bind-mounts.service
Requires=rtmr3-verify.service
# Must inject the real caBundle into the webhook manifests BEFORE k3s applies
# them (setup-storage-bind-mounts evicted the addon tracking so k3s re-applies
# on start), and complete before the admission controller starts serving.
Before=k3s.service
Before=admission-controller.service

[Service]
Type=oneshot
# Optional debug flag (GENERATE_ADMISSION_CERT_DEBUG_MODE=true) written only on
# debug builds; absent on production, where a failure powers the VM off.
EnvironmentFile=-/etc/default/generate-admission-cert
ExecStart=/usr/local/bin/generate-admission-cert
RemainAfterExit=yes
TimeoutStartSec=120
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
