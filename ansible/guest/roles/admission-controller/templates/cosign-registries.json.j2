{
  "registries": [
    {
      "registry": "docker.io",
      "require_signature": false,
      "verification_method": "disabled",
      "organizations": {
        "parachutes": {
          "organization": "parachutes",
          "require_signature": true,
          "verification_method": "key",
          "public_key": "/run/chutes/signing-keys/cosign/dockerhub.pub",
          "rekor_url": "https://rekor.sigstore.dev"
        }
      }
    },
    {
      "registry": "gcr.io",
      "require_signature": false,
      "verification_method": "disabled",
      "organizations": {
        "distroless": {
          "organization": "distroless",
          "require_signature": true,
          "verification_method": "keyless",
          "keyless_identity_regex": "^https://github.com/GoogleContainerTools/distroless/.*",
          "keyless_issuer": "https://token.actions.githubusercontent.com",
          "rekor_url": "https://rekor.sigstore.dev"
        }
      }
    },
    {
      "registry": "registry.k8s.io",
      "require_signature": false,
      "verification_method": "disabled"
    },
    {
      "registry": "nvcr.io",
      "require_signature": false,
      "verification_method": "disabled"
    },
    {
      "registry": "quay.io",
      "require_signature": false,
      "verification_method": "disabled"
    },
    {
      "registry": "registry.chutes.ai",
      "require_signature": true,
      "verification_method": "key",
      "public_key": "/run/chutes/signing-keys/cosign/chutes.pub",
      "rekor_url": "https://rekor.sigstore.dev"
    },
    {
      "registry": "*",
      "require_signature": true,
      "verification_method": "key",
      "public_key": "/run/chutes/signing-keys/cosign/chutes.pub",
      "rekor_url": "https://rekor.sigstore.dev"
    }
  ],
  "pin_digest_whitelist": [
    {
      "image": "docker.io/parachutes/failed-chute-cleanup",
      "ttl": 3600
    }
  ]
}
