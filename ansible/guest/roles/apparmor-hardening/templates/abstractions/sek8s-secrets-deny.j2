# vim: ft=apparmor
# sek8s-secrets-deny — deny access to high-value runtime secrets
# Included by the deny-sensitive-default profile to block shell/interpreter
# access to credentials and runtime sockets.
{% set deny_kw = 'audit deny' if debug_build | default(false) else 'deny' %}

  # Boot-time secrets on tmpfs (encryption keys, nonces, validator auth)
  {{ deny_kw }} /run/chutes/ r,
  {{ deny_kw }} /run/chutes/** rwlk,

  # k3s containerd socket (can pull/push/exec container images)
  {{ deny_kw }} /run/k3s/containerd/containerd.sock rw,

  # k3s cluster join token
  {{ deny_kw }} /var/lib/rancher/k3s/server/token r,

  # Miner credentials (HF token, seed phrase)
  {{ deny_kw }} /etc/system-manager/miner.env r,
