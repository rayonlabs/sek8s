[Unit]
Description=Benchmark VM Network Connection Logger
Documentation=https://github.com/rayonlabs/sek8s
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/chutes/benchmark-netlog.env
ExecStart=/usr/local/bin/benchmark-netlog.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=benchmark-netlog

# Limit journal spam on repeated restarts
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
