/var/log/chutes/benchmark-netlog/netlog-*.log {
    daily
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    # Do not use postrotate/copytruncate — the logging script opens a new
    # date-stamped file automatically at midnight, so no signal is needed.
    nocopytruncate
}
